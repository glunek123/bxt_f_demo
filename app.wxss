page {
  min-height: 100%;
  background: #F5F5F7;
  color: #1D1D1F;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, picker, switch { box-sizing: border-box; }
button::after { border: 0; }

.page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
.page.with-action { padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); }
.eyebrow {
  color: #6E6E73;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.page-title {
  margin-top: 8rpx;
  color: #1D1D1F;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.15;
}
.page-lead {
  margin-top: 14rpx;
  color: #6E6E73;
  font-size: 27rpx;
  line-height: 1.6;
}
.section-title {
  margin: 38rpx 4rpx 16rpx;
  color: #1D1D1F;
  font-size: 30rpx;
  font-weight: 650;
}
.section-caption {
  margin: -8rpx 4rpx 18rpx;
  color: #86868B;
  font-size: 23rpx;
}

.card, .group, .order {
  margin-bottom: 20rpx;
  padding: 30rpx;
  overflow: hidden;
  background: rgba(255,255,255,.94);
  border: 1rpx solid rgba(0,0,0,.055);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(11,31,58,.055);
}
.card-title { color: #1D1D1F; font-size: 30rpx; font-weight: 650; }
.card-sub { margin-top: 7rpx; color: #86868B; font-size: 24rpx; line-height: 1.55; }
.card.dark {
  color: #FFFFFF;
  background: linear-gradient(145deg, #071426 0%, #0B1F3A 62%, #163761 100%);
  border: 0;
  box-shadow: 0 18rpx 48rpx rgba(11,31,58,.22);
}
.card.dark .card-title, .card.dark .page-lead { color: #FFFFFF; }

.demo-pill, .tag {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 4rpx 15rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
}
.demo-pill { color: #0B1F3A; background: rgba(11,31,58,.08); }
.tag { color: #6E6E73; background: #F0F0F2; }
.tag-navy { color: #0B1F3A; background: rgba(11,31,58,.09); }
.tag-green { color: #207A3C; background: rgba(52,199,89,.12); }
.tag-warn { color: #A86100; background: rgba(255,159,10,.14); }
.tag-danger { color: #C8271F; background: rgba(255,59,48,.11); }
.tag-blue { color: #0068D8; background: rgba(0,122,255,.10); }
.tag-gray { color: #6E6E73; background: #F0F0F2; }

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.flex1 { flex: 1; min-width: 0; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.muted, .hint { color: #86868B; font-size: 23rpx; }
.hint { margin-top: 8rpx; line-height: 1.55; }
.divider { height: 1rpx; margin: 24rpx 0; background: rgba(0,0,0,.07); }

.btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.2;
}
.btn-primary { color: #FFFFFF; background: #0B1F3A; }
.btn-secondary { color: #0B1F3A; background: rgba(11,31,58,.08); }
.btn-ghost { color: #0B1F3A; background: #FFFFFF; border: 1rpx solid rgba(11,31,58,.17); }
.btn-danger { color: #D92D20; background: rgba(255,59,48,.09); }
.btn-block { width: 100%; }
.btn-sm { display: inline-flex; min-height: 68rpx; padding: 0 24rpx; font-size: 25rpx; }
.btn[disabled] { opacity: .42; }
.btn + .btn { margin-top: 16rpx; }
.text-action { color: #0066CC; font-size: 26rpx; font-weight: 550; }

.action-bar {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(251,251,253,.92);
  border-top: 1rpx solid rgba(0,0,0,.06);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}

.cell, .kv, .switch-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,.065);
}
.cell:last-child, .kv:last-child, .switch-row:last-child { border-bottom: 0; }
.cell-label, .kv .k { color: #1D1D1F; font-size: 27rpx; }
.cell-value, .kv .v { max-width: 64%; color: #6E6E73; font-size: 25rpx; text-align: right; }
.cell-arrow { margin-left: 10rpx; color: #AEAEB2; font-size: 30rpx; }
.cell-sub { margin-top: 4rpx; color: #86868B; font-size: 22rpx; }

.field { margin-bottom: 30rpx; }
.field-label { margin-bottom: 13rpx; color: #1D1D1F; font-size: 25rpx; font-weight: 600; }
.req { color: #FF3B30; }
.input, .textarea, .select-box {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  color: #1D1D1F;
  background: #FFFFFF;
  border: 1rpx solid rgba(0,0,0,.11);
  border-radius: 20rpx;
  font-size: 27rpx;
}
.textarea { min-height: 210rpx; line-height: 1.55; }
.input.low, .select-box.low { border-color: #FF9F0A; box-shadow: 0 0 0 4rpx rgba(255,159,10,.08); }
.counter { margin-top: 8rpx; color: #86868B; font-size: 22rpx; text-align: right; }

.seg {
  display: flex;
  padding: 6rpx;
  background: #E9E9EC;
  border-radius: 999rpx;
}
.seg-item {
  flex: 1;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6E6E73;
  border-radius: 999rpx;
  font-size: 25rpx;
}
.seg-item.on {
  color: #1D1D1F;
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,.09);
  font-weight: 600;
}

.status-orb {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: #0B1F3A;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 700;
}
.status-orb.green { background: #34C759; }
.status-orb.orange { background: #FF9F0A; }
.status-orb.red { background: #FF3B30; }

.timeline { position: relative; padding-left: 32rpx; }
.timeline::before {
  position: absolute;
  top: 12rpx;
  bottom: 18rpx;
  left: 9rpx;
  width: 2rpx;
  content: "";
  background: #D8D8DC;
}
.timeline-item { position: relative; padding: 0 0 28rpx 16rpx; }
.timeline-item::before {
  position: absolute;
  top: 9rpx;
  left: -28rpx;
  width: 14rpx;
  height: 14rpx;
  content: "";
  background: #0B1F3A;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(11,31,58,.16);
}
.timeline-title { color: #1D1D1F; font-size: 26rpx; font-weight: 600; }
.timeline-desc, .timeline-time { margin-top: 5rpx; color: #86868B; font-size: 22rpx; line-height: 1.55; }

.notice {
  padding: 22rpx 24rpx;
  color: #5C4A19;
  background: rgba(255,204,0,.10);
  border: 1rpx solid rgba(180,130,0,.16);
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
}
.info-note {
  padding: 22rpx 24rpx;
  color: #44546A;
  background: rgba(0,122,255,.07);
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
}
.danger-note {
  padding: 22rpx 24rpx;
  color: #9A2820;
  background: rgba(255,59,48,.08);
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
}
.empty { padding: 88rpx 36rpx; color: #86868B; text-align: center; }
.empty-title { color: #1D1D1F; font-size: 30rpx; font-weight: 650; }
.empty-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.55; }

.group { padding: 6rpx 28rpx; }
.group-title { padding: 22rpx 0 8rpx; color: #86868B; font-size: 22rpx; font-weight: 600; letter-spacing: 1rpx; }
.sr-main { flex: 1; }
.sr-label { color: #1D1D1F; font-size: 27rpx; }
.sr-sub { margin-top: 4rpx; color: #86868B; font-size: 22rpx; }
.success-box { padding: 58rpx 24rpx; text-align: center; }
.s-icon {
  width: 88rpx; height: 88rpx; margin: 0 auto 24rpx; display: flex; align-items: center; justify-content: center;
  color: #FFFFFF; background: #34C759; border-radius: 50%; font-size: 40rpx; font-weight: 700;
}
.s-title { color: #1D1D1F; font-size: 34rpx; font-weight: 700; }
.s-sub { margin-top: 12rpx; color: #86868B; font-size: 24rpx; line-height: 1.6; }
.fb-code { margin: 18rpx 0; color: #0B1F3A; font-size: 25rpx; font-weight: 650; }
.upload-box, .upload-thumb {
  display: flex; align-items: center; justify-content: center; color: #86868B;
  background: #F2F2F4; border: 1rpx dashed #C7C7CC; border-radius: 20rpx; font-size: 21rpx; text-align: center;
}
.ub-plus { font-size: 42rpx; }
.loading-box { padding: 70rpx 0; color: #86868B; text-align: center; }
.e-icon {
  width: 82rpx; height: 82rpx; margin: 0 auto 18rpx; display: flex; align-items: center; justify-content: center;
  color: #86868B; background: #E9E9EC; border-radius: 50%; font-size: 28rpx; font-weight: 650;
}
.e-text { color: #86868B; font-size: 24rpx; text-align: center; }

.faq-item { margin-bottom: 14rpx; padding: 0 28rpx; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.055); border-radius: 24rpx; }
.faq-q { min-height: 94rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; font-size: 27rpx; font-weight: 600; }
.faq-q .arrow { color: #AEAEB2; font-size: 34rpx; transition: transform .2s; }
.faq-q .arrow.open { transform: rotate(90deg); }
.faq-a { padding: 0 0 28rpx; color: #6E6E73; font-size: 24rpx; line-height: 1.7; }

.msg-item { display: flex; gap: 15rpx; padding: 24rpx 0; border-bottom: 1rpx solid rgba(0,0,0,.06); }
.msg-item:last-child { border-bottom: 0; }
.msg-dot { width: 14rpx; height: 14rpx; margin-top: 12rpx; flex-shrink: 0; background: #FF3B30; border-radius: 50%; }
.msg-dot.read { background: transparent; }
.msg-body { flex: 1; min-width: 0; }
.msg-head { display: flex; justify-content: space-between; gap: 14rpx; }
.msg-title { flex: 1; font-size: 25rpx; font-weight: 600; }
.msg-time { color: #AEAEB2; font-size: 20rpx; white-space: nowrap; }
.msg-summary { margin-top: 8rpx; color: #86868B; font-size: 22rpx; line-height: 1.55; }
.mtype { margin-right: 8rpx; padding: 3rpx 10rpx; color: #0B1F3A; background: rgba(11,31,58,.08); border-radius: 999rpx; font-size: 19rpx; }

.voucher { margin-bottom: 20rpx; display: flex; overflow: hidden; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.055); border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(11,31,58,.045); }
.voucher .left { width: 180rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #FFFFFF; background: #0B1F3A; }
.voucher.used .left, .voucher.expired .left { background: #8E8E93; }
.voucher .right { flex: 1; min-width: 0; padding: 25rpx; }
.amt { font-size: 46rpx; font-weight: 700; }
.amt .u { font-size: 24rpx; }
.vn { color: rgba(255,255,255,.65); font-size: 21rpx; }
.vname { font-size: 26rpx; font-weight: 650; }
.vstatus { color: #207A3C; font-size: 22rpx; }
.vrow { margin-top: 8rpx; color: #86868B; font-size: 21rpx; }
.vk { margin-right: 8rpx; color: #525256; }

.order-head, .order-row { display: flex; justify-content: space-between; gap: 20rpx; }
.order-id { max-width: 70%; overflow: hidden; color: #1D1D1F; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-status { color: #207A3C; font-size: 23rpx; font-weight: 600; }
.order-demand { margin-top: 18rpx; font-size: 26rpx; font-weight: 600; }
.order-row { margin-top: 10rpx; color: #86868B; font-size: 23rpx; }
.order-row .v { color: #1D1D1F; }
.order-method, .order-sep { margin-top: 14rpx; color: #86868B; font-size: 22rpx; line-height: 1.55; }

.mask {
  position: fixed;
  z-index: 80;
  top: 0; right: 0; bottom: 0; left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,.42);
}
.sheet {
  width: 100%;
  max-height: 86vh;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: #FBFBFD;
  border-radius: 36rpx 36rpx 0 0;
}
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; background: #D1D1D6; border-radius: 999rpx; }
.sheet-title { color: #1D1D1F; font-size: 34rpx; font-weight: 700; }
.choice {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,.07);
  font-size: 27rpx;
}
.check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C7C7CC;
  border-radius: 50%;
}
.check.on { background: #0B1F3A; border-color: #0B1F3A; box-shadow: inset 0 0 0 8rpx #FFFFFF; }

@media (min-width: 480px) {
  .page { max-width: 880rpx; margin: 0 auto; }
  .action-bar > view, .action-bar > button { max-width: 824rpx; margin-right: auto; margin-left: auto; }
}
