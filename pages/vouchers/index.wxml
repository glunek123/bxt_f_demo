<!-- pages/vouchers/index.wxml -->
<view class="page">
  <view class="demo-pill">1 元补贴券 · 本地 Mock</view>

  <view class="card">
    <view class="card-title">1 元补贴券规则</view>
    <view class="divider"></view>
    <view class="muted" style="line-height:1.8;font-size:24rpx">
      <view>· 同一需求、同一接单律师、同一券类型仅发放一张。</view>
      <view>· 券抵扣后应付 0 元时，走内部零支付订单，不调用微信支付。</view>
      <view>· 仅符合条件的锁后失败接收律师，在有效期内首次查看结果或接受失败时获得。</view>
      <view>· 成功锁定的赢家不获得补贴券；已拒绝和已超时邀请保持原终态。</view>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}"><view class="spin"></view>加载中…</view>

  <block wx:elif="{{list.length === 0}}">
    <view class="empty">
      <view class="e-icon">券</view>
      <view class="e-text">暂无补贴券</view>
    </view>
  </block>

  <block wx:else>
    <view class="voucher {{item.status==='已使用'?'used':''}} {{item.status==='已过期'?'expired':''}}" wx:for="{{list}}" wx:key="id">
      <view class="left">
        <view class="amt">¥1<text class="u">.00</text></view>
        <view class="vn">补贴券</view>
      </view>
      <view class="right">
        <view class="between">
          <view class="vname">{{item.name}}</view>
          <view class="vstatus {{item.statusClass}}">{{item.status}}</view>
        </view>
        <view class="vrow"><text class="vk">抵扣</text>{{item.desc}}</view>
        <view class="vrow"><text class="vk">绑定需求</text>{{item.bindDemand}}</view>
        <view class="vrow"><text class="vk">绑定律师</text>{{item.bindLawyer}}</view>
        <view class="vrow"><text class="vk">有效期至</text>{{item.validTo}}</view>
      </view>
    </view>
  </block>
</view>
