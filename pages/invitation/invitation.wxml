<view class="page with-action">
  <view class="between">
    <view class="demo-pill">P03 · 当前律师视图</view>
    <view class="text-action" bindtap="goSettings">接收设置</view>
  </view>

  <block wx:if="{{invitation}}">
    <view class="page-title">协作邀请</view>
    <view class="page-lead">本页仅展示当前登录律师自己的邀请，不提供候选列表、排名或代替他人接单能力。</view>

    <view class="card status-card">
      <view class="between">
        <view class="tag {{invitation.status === 'PENDING' ? 'tag-warn' : invitation.status === 'ACCEPTED' ? 'tag-green' : 'tag-gray'}}">{{statusText}}</view>
        <view wx:if="{{invitation.status === 'PENDING'}}" class="countdown">{{countdown}}</view>
      </view>
      <view class="invite-title">{{invitation.scene}} · {{invitation.city}}</view>
      <view class="card-sub">{{invitation.serviceItem}}</view>
    </view>

    <view class="card">
      <view class="between">
        <view>
          <view class="initiator">{{invitation.initiatorName}}</view>
          <view class="card-sub">{{invitation.initiatorRegion}} · {{invitation.initiatorCertification}}</view>
        </view>
        <view class="tag tag-green">认证有效</view>
      </view>
      <view class="divider"></view>
      <view class="kv"><view class="k">目标机构</view><view class="v">{{invitation.institution}}</view></view>
      <view class="kv"><view class="k">协作事项</view><view class="v">{{invitation.serviceItem}}</view></view>
      <view class="kv"><view class="k">期望时间</view><view class="v">{{invitation.serviceAtText}}</view></view>
    </view>

    <view class="info-note">邀请内容仅包含经发起方确认的脱敏结构化摘要。接受后由服务端唯一锁决定结果，页面顺序不代表优先级。</view>

    <view wx:if="{{invitation.status === 'INVALIDATED_BY_LOCK' || resultCode === 'LOCKED_BY_OTHER'}}" class="card voucher-result">
      <view class="tag tag-green">锁后补贴</view>
      <view class="result-title">其他律师已先完成有效接受</view>
      <view class="card-sub">您在邀请有效期内首次查看锁后结果，已获得 1 元补贴券。赢家不会获得该券，重复查看不会重复发放。</view>
      <view class="text-action mt24" bindtap="goVoucher">查看补贴券</view>
    </view>

    <view wx:if="{{invitation.status === 'ACCEPTED'}}" class="card success-result">
      <view class="result-mark">✓</view>
      <view class="result-title">已接受本次邀请</view>
      <view class="card-sub">等待发起方确认连接并按入口完成入群。请勿通过其他律师身份操作。</view>
    </view>

    <view wx:if="{{invitation.status === 'REJECTED' || invitation.status === 'TIMEOUT_REJECTED'}}" class="card">
      <view class="result-title">{{invitation.status === 'REJECTED' ? '已拒绝本次邀请' : '邀请已超时'}}</view>
      <view class="card-sub">该终态不会因为后续锁定、切批或重匹配而被改写。</view>
    </view>

    <view wx:if="{{resultCode === 'QUALIFICATION_ERROR'}}" class="danger-note">
      {{qualificationMessage}} 请前往 P05 检查认证与接收设置，当前邀请未被他人代操作。
    </view>
  </block>

  <view wx:else class="card empty">
    <view class="empty-title">暂无协作邀请</view>
    <view class="empty-sub">邀请只发送给当前认证律师，并受接收设置与有效期控制。</view>
  </view>

  <view class="action-bar">
    <view wx:if="{{invitation && invitation.status === 'PENDING'}}" class="action-row">
      <button class="btn btn-primary flex1" loading="{{busy}}" bindtap="accept">接受邀请</button>
      <button class="btn btn-secondary reject-btn" bindtap="showReject">暂不接受</button>
    </view>
    <button wx:else class="btn btn-secondary btn-block" bindtap="goList">返回我的协作</button>
  </view>

  <view wx:if="{{rejectOpen}}" class="mask">
    <view class="sheet">
      <view class="sheet-handle"></view>
      <view class="sheet-title">暂不接受的原因</view>
      <view class="mt24">
        <view wx:for="{{reasons}}" wx:key="*this" class="choice" data-reason="{{item}}" bindtap="pickReason">
          <text>{{item}}</text><view class="check {{reason === item ? 'on' : ''}}"></view>
        </view>
      </view>
      <button class="btn btn-primary btn-block mt24" bindtap="reject">确认暂不接受</button>
      <button class="btn btn-secondary btn-block" bindtap="hideReject">取消</button>
    </view>
  </view>
</view>
