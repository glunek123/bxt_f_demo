<!-- pages/settings/index.wxml -->
<view class="page">
  <view class="demo-pill">偏好设置 · 本地 Mock</view>

  <!-- 账号与身份 -->
  <view class="group">
    <view class="group-title">账号与身份</view>
    <view class="cell">
      <view class="cell-label">当前律师</view>
      <view class="cell-value">{{profile.name}} · {{profile.identity}}</view>
    </view>
    <view class="cell">
      <view class="cell-label">认证状态</view>
      <view class="cell-value"><text class="tag tag-green">已认证</text></view>
    </view>
    <view class="cell">
      <view class="cell-label">手机号</view>
      <view class="cell-value">138****8000 <text class="tag tag-gray" style="margin-left:8rpx">虚构</text></view>
    </view>
  </view>

  <!-- 通知偏好 -->
  <view class="group">
    <view class="group-title">通知偏好</view>
    <view class="switch-row">
      <view class="sr-main">
        <view class="sr-label">站内邀请提醒</view>
        <view class="sr-sub">收到当前律师自己的协作邀请时提醒</view>
      </view>
      <switch checked="{{settings.inviteNotify}}" color="#13294B" data-key="inviteNotify" bindchange="toggle" />
    </view>
    <view class="switch-row">
      <view class="sr-main">
        <view class="sr-label">匹配结果提醒</view>
        <view class="sr-sub">批次邀请结果变化时提醒（演示）</view>
      </view>
      <switch checked="{{settings.matchNotify}}" color="#13294B" data-key="matchNotify" bindchange="toggle" />
    </view>
    <view class="switch-row">
      <view class="sr-main">
        <view class="sr-label">协作状态提醒</view>
        <view class="sr-sub">入群 / 协作进展提醒（演示）</view>
      </view>
      <switch checked="{{settings.collabNotify}}" color="#13294B" data-key="collabNotify" bindchange="toggle" />
    </view>
  </view>

  <!-- 隐私与安全 -->
  <view class="group">
    <view class="group-title">隐私与安全</view>
    <view class="switch-row">
      <view class="sr-main">
        <view class="sr-label">敏感信息默认遮罩</view>
        <view class="sr-sub">开启后详情页隐藏敏感字段（演示）</view>
      </view>
      <switch checked="{{settings.maskSensitive}}" color="#13294B" data-key="maskSensitive" bindchange="toggle" />
    </view>
    <view class="cell" bindtap="goPrivacy">
      <view class="cell-label">查看隐私说明</view>
      <view class="cell-value"><text class="cell-arrow">›</text></view>
    </view>
    <view class="muted" style="padding:16rpx 0;line-height:1.7">平台不保存原始案情正文；用户确认的结构化字段才是发布真值。</view>
  </view>

  <!-- 关于产品 -->
  <view class="group">
    <view class="group-title">关于产品</view>
    <view class="cell"><view class="cell-label">版本号</view><view class="cell-value">PAC Demo v2.0</view></view>
    <view class="cell" bindtap="goAbout">
      <view class="cell-label">进入关于页</view>
      <view class="cell-value"><text class="cell-arrow">›</text></view>
    </view>
  </view>
</view>
