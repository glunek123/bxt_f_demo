.snapshot-label { color: rgba(255,255,255,.56); font-size: 22rpx; }
.snapshot-status { margin-top: 6rpx; color: #FFFFFF; font-size: 40rpx; font-weight: 700; }
.console-tag { color: #FFFFFF; background: rgba(255,255,255,.14); }
.snapshot-grid { margin-top: 30rpx; display: flex; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.12); }
.snapshot-grid view { flex: 1; display: flex; flex-direction: column; }
.snapshot-grid text { color: #FFFFFF; font-size: 32rpx; font-weight: 700; }
.snapshot-grid label { margin-top: 3rpx; color: rgba(255,255,255,.54); font-size: 21rpx; }
.scenario-list { overflow: hidden; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.055); border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(11,31,58,.045); }
.scenario { min-height: 116rpx; display: flex; align-items: center; gap: 18rpx; padding: 22rpx 28rpx; border-bottom: 1rpx solid rgba(0,0,0,.06); }
.scenario:last-child { border-bottom: 0; }
.scenario-name { font-size: 27rpx; font-weight: 600; }
.scenario-desc { margin-top: 4rpx; color: #86868B; font-size: 22rpx; }
.scenario-arrow { color: #AEAEB2; font-size: 38rpx; }
.candidate { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(0,0,0,.06); }
.candidate:last-child { border-bottom: 0; }
.candidate-name { font-size: 25rpx; font-weight: 600; }
.score { color: #0B1F3A; font-size: 31rpx; font-weight: 700; }
