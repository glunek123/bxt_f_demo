.filters { width: 100%; margin: 24rpx 0; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.filter { min-height: 62rpx; display: flex; align-items: center; padding: 0 25rpx; color: #6E6E73; background: #E9E9EC; border-radius: 999rpx; font-size: 24rpx; }
.filter.on { color: #FFFFFF; background: #0B1F3A; }
.item-title { margin-top: 22rpx; font-size: 31rpx; font-weight: 650; }
.clamp { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta-row { margin-top: 24rpx; display: flex; justify-content: space-between; color: #86868B; font-size: 23rpx; }
