<view class="page">
  <view class="demo-pill">P04 · 我的协作</view>
  <view class="page-title">协作</view>

  <view class="seg mt32">
    <view class="seg-item {{role === 'initiator' ? 'on' : ''}}" data-role="initiator" bindtap="changeRole">我发起的</view>
    <view class="seg-item {{role === 'receiver' ? 'on' : ''}}" data-role="receiver" bindtap="changeRole">我接收的</view>
  </view>

  <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="*this" class="filter {{filter === item ? 'on' : ''}}" data-filter="{{item}}" bindtap="changeFilter">{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{items.length}}">
    <view wx:for="{{items}}" wx:key="id" class="card collab-card" data-index="{{index}}" bindtap="openItem">
      <view class="between">
        <view class="tag {{item.statusText === '沟通中' ? 'tag-green' : 'tag-navy'}}">{{item.statusText}}</view>
        <view class="text-action">{{item.nextAction}}</view>
      </view>
      <view class="item-title">{{item.scene}} · {{item.city}}</view>
      <view class="card-sub clamp">{{item.institution}}</view>
      <view class="meta-row">
        <view>关键时间</view>
        <view>{{item.expectTime}}</view>
      </view>
    </view>
  </view>

  <view wx:else class="card empty">
    <view class="empty-title">当前筛选下暂无协作</view>
    <view class="empty-sub">{{role === 'initiator' ? '可以发布一条新的异地协作需求。' : '待处理邀请会进入站内邀请箱。'}}</view>
    <button wx:if="{{role === 'initiator'}}" class="btn btn-primary btn-block mt24" bindtap="goPublish">发布协作</button>
  </view>
</view>
