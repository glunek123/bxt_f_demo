.launch-card {
  margin-top: 34rpx;
  min-height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx;
  color: #FFFFFF;
  background: linear-gradient(145deg, #071426, #0B1F3A 65%, #174171);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 54rpx rgba(11,31,58,.24);
}
.launch-title { font-size: 36rpx; font-weight: 700; }
.launch-sub { margin-top: 10rpx; color: rgba(255,255,255,.7); font-size: 24rpx; }
.launch-arrow {
  width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center;
  color: #0B1F3A; background: #FFFFFF; border-radius: 50%; font-size: 36rpx;
}
.invite-title, .active-title { margin-top: 22rpx; color: #1D1D1F; font-size: 31rpx; font-weight: 650; }
.active-time { margin-top: 18rpx; color: #6E6E73; font-size: 23rpx; }
.scene-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.scene-card {
  width: calc(50% - 9rpx);
  min-height: 190rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0,0,0,.055);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(11,31,58,.045);
}
.scene-card.pilot { width: 100%; min-height: 166rpx; }
.scene-symbol {
  width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center;
  color: #0B1F3A; background: rgba(11,31,58,.08); border-radius: 18rpx;
  font-size: 25rpx; font-weight: 700;
}
.scene-name { margin-top: 26rpx; font-size: 28rpx; font-weight: 650; }
.scene-desc { margin-top: 5rpx; color: #86868B; font-size: 22rpx; }
.privacy-line { padding: 38rpx 10rpx 16rpx; color: #9A9A9F; font-size: 21rpx; text-align: center; }
