/* pages/rematch/rematch.wxss */
.candidate {
  background: #F7F9FB;
  border: 2rpx solid #E3E8EF;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

/* 重新匹配专属流程步骤 */
.flow {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 16rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(19, 41, 75, 0.06);
}
.flow-step { flex: 1; position: relative; text-align: center; }
.flow-dot {
  width: 52rpx; height: 52rpx; line-height: 52rpx; border-radius: 50%;
  margin: 0 auto; background: #E3E8EF; color: #8A94A6;
  font-size: 26rpx; font-weight: 600; position: relative; z-index: 2;
}
.flow-dot.done { background: #13294B; color: #fff; }
.flow-dot.active { background: #C8A45C; color: #fff; box-shadow: 0 0 0 6rpx rgba(200, 164, 92, 0.18); }
.flow-lbl { margin-top: 12rpx; font-size: 22rpx; color: #8A94A6; }
.flow-lbl.cur { color: #13294B; font-weight: 600; }
.flow-ln { position: absolute; top: 26rpx; left: 50%; width: 100%; height: 4rpx; background: #E3E8EF; z-index: 1; }
.flow-ln.done { background: #13294B; }

/* 群聊盒子 */
.group-box {
  background: rgba(19, 41, 75, 0.04);
  border: 2rpx solid #E3E8EF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.group-name { font-weight: 700; color: #13294B; font-size: 30rpx; }

/* 受控入群二维码弹窗（与 P04 统一） */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.qr-sheet {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #13294B;
}
.qr-sub {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 8rpx;
}
.qr-canvas {
  width: 440rpx;
  height: 440rpx;
  margin: 24rpx 0 8rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 8rpx;
}
