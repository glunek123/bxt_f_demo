.profile-head { display: flex; align-items: center; gap: 20rpx; margin-top: 38rpx; }
.avatar {
  width: 102rpx; height: 102rpx; display: flex; align-items: center; justify-content: center;
  color: #FFFFFF; background: linear-gradient(145deg, #0B1F3A, #1B4779); border-radius: 32rpx;
  font-size: 39rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(11,31,58,.22);
}
.profile-name { font-size: 38rpx; font-weight: 700; }
.stats {
  margin-top: 34rpx; display: flex; padding: 24rpx 10rpx;
  background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.055); border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(11,31,58,.045);
}
.stats view { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid rgba(0,0,0,.06); }
.stats view:last-child { border-right: 0; }
.stats text { color: #1D1D1F; font-size: 34rpx; font-weight: 700; }
.stats label { margin-top: 4rpx; color: #86868B; font-size: 21rpx; }
.menu-card { padding-top: 4rpx; padding-bottom: 4rpx; }
.console-card { color: #FFFFFF; background: linear-gradient(145deg, #071426, #0B1F3A 65%, #174171); }
.console-title { font-size: 29rpx; font-weight: 650; }
.console-card .card-sub { color: rgba(255,255,255,.62); }
.console-arrow {
  width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center;
  color: #0B1F3A; background: #FFFFFF; border-radius: 50%; font-size: 28rpx;
}
