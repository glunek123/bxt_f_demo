.scene-picker { display: flex; gap: 12rpx; overflow-x: auto; }
.scene-option {
  min-width: 190rpx; min-height: 82rpx; display: flex; align-items: center; justify-content: center;
  color: #6E6E73; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.08);
  border-radius: 22rpx; font-size: 25rpx;
}
.scene-option.on { color: #FFFFFF; background: #0B1F3A; border-color: #0B1F3A; font-weight: 600; }
.scene-option.pilot { color: #6E6E73; background: #EBEBED; }
.error { margin-top: 8rpx; color: #FF3B30; font-size: 22rpx; }
.orange { color: #A86100; }
.action-row { display: flex; gap: 14rpx; }
.draft-btn { width: 32%; }
.preview-btn { flex: 1; }
.notice-copy { margin-top: 26rpx; color: #525256; font-size: 26rpx; line-height: 2; }
