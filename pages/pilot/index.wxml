<view class="page">
  <view class="demo-pill">受限试点 · 不进入正式流程</view>
  <view class="page-title">代开庭意向</view>
  <view class="page-lead">正式 MVP 默认关闭代开庭匹配。当前页面只登记试点兴趣，不创建需求版本、候选、邀请、订单、补贴券或协作群。</view>

  <view wx:if="{{!submitted}}">
    <view class="danger-note mt32">代开庭涉及额外法律与运营边界。在全局、城市和用户门禁获批前，仅允许登记意向。</view>
    <view class="card mt24">
      <view class="field"><view class="field-label">意向城市</view><input class="input" data-key="city" value="{{city}}" bindinput="setField"/></view>
      <view class="field"><view class="field-label">法院</view><input class="input" data-key="court" value="{{court}}" bindinput="setField"/></view>
      <view class="field"><view class="field-label">后续通知方式</view><view class="select-box">站内消息</view></view>
    </view>
    <button class="btn btn-primary btn-block" loading="{{busy}}" bindtap="submit">登记试点意向</button>
  </view>

  <view wx:else class="card result">
    <view class="result-mark">✓</view>
    <view class="result-title">意向已登记</view>
    <view class="card-sub">编号 {{record.id}} · {{record.createdAtText}}</view>
    <view class="info-note mt24">本次登记没有触发审核、匹配、支付、入群或补贴券逻辑。</view>
    <button class="btn btn-primary btn-block mt32" bindtap="home">返回首页</button>
  </view>
</view>
