/* pages/match/match.wxss */

/* 视角切换条 */
.view-mode-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(19,41,75,.04);
}
.vm-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #8A94A6;
  border-radius: 10rpx;
  line-height: 1.4;
}
.vm-item.on {
  background: #13294B;
  color: #fff;
  font-weight: 600;
}

/* 大状态卡（用户视角三态） */
.big-state {
  padding: 40rpx 32rpx;
}
.state-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  margin: 0 auto 20rpx;
  line-height: 1;
}
.state-matching .state-icon {
  background: rgba(19,41,75,.08);
  color: #13294B;
}
.state-matching .state-icon.spin {
  animation: pulse 1.6s ease-in-out infinite;
}
.state-locked .state-icon {
  background: rgba(43,164,113,.12);
  color: #2BA471;
}
.state-expired .state-icon {
  background: rgba(217,80,62,.10);
  color: #D9503E;
}
.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #13294B;
  text-align: center;
  line-height: 1.4;
}
.state-sub {
  font-size: 26rpx;
  color: #5A6473;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.7;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.08); opacity: .75; }
}

/* 赢家卡片（用户视角锁定态） */
.winner-card {
  background: rgba(43,164,113,.06);
  border: 1rpx solid rgba(43,164,113,.3);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.winner-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #13294B;
  line-height: 1.3;
}
.winner-score {
  font-size: 26rpx;
  font-weight: 700;
}

/* 内部视角：批次分组 + 候选卡（保留原有样式） */
.batch {
  margin-top: 20rpx;
  border-top: 1rpx solid #EEF1F5;
  padding-top: 16rpx;
}
.batch:first-of-type { border-top: none; padding-top: 0; }
.batch-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
}
.batch-no { font-size: 26rpx; color: #13294B; font-weight: 600; }
.candidate {
  background: #F7F9FB;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.candidate:last-child { margin-bottom: 0; }

/* 演示控制区 */
.demo-ctrl {
  background: rgba(232,149,27,.04);
  border: 1rpx dashed rgba(232,149,27,.4);
}
